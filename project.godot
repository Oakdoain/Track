;   param=value ; assign values to parameters

config_version=5

[application]

config/name="第三轨：隔音室谋杀案"
run/main_scene="res://scenes/AppRoot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

StoryManager="*uid://dih1cw41o7kau"
AudioManager="*res://scripts/audio/AudioManager.gd"
UISoundManager="*res://scripts/audio/UISoundManager.gd"
CursorManager="*res://scripts/ui/CursorManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1032
window/stretch/aspect="ignore"
window/stretch/scale_mode="integer"

